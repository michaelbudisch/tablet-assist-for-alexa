<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorButtonNormal">@color/surface_high</item>
        <item name="android:colorBackgroundFloating">@color/surface_high</item>
        <item name="android:colorEdgeEffect">@color/accent</item>
        <item name="android:popupBackground">@color/surface_high</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">22dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="Heading" parent="Body">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Eyebrow" parent="Body">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>
    <style name="Action">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/action_text</item>
    </style>
    <style name="Primary" parent="Action">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Tab" parent="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:paddingLeft">3dp</item>
        <item name="android:paddingRight">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Language" parent="Action">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Quiet" parent="Action">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:background">@drawable/bg_quiet</item>
    </style>
    <style name="Disclosure" parent="Quiet">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:drawableEnd">@drawable/ic_expand</item>
        <item name="android:drawablePadding">12dp</item>
    </style>
    <style name="Choice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">42dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>
</resources>
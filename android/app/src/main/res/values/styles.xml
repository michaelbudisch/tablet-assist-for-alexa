<resources>
<style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
<item name="android:fontFamily">sans</item><item name="android:windowBackground">@color/page</item>
<item name="android:colorAccent">@color/accent</item><item name="android:statusBarColor">@color/page</item>
<item name="android:navigationBarColor">@color/page</item><item name="android:windowLightStatusBar">false</item>
<item name="android:windowLightNavigationBar">false</item><item name="android:textColorPrimary">@color/ink</item>
<item name="android:textColorSecondary">@color/muted</item><item name="android:windowActionModeOverlay">true</item>
</style>
<style name="Card"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:orientation">vertical</item><item name="android:background">@drawable/bg_card</item>
<item name="android:padding">22dp</item><item name="android:layout_marginBottom">16dp</item></style>
<style name="Body"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingExtra">4dp</item>
<item name="android:layout_marginTop">10dp</item></style>
<style name="Heading" parent="Body"><item name="android:textSize">21sp</item><item name="android:textColor">@color/ink</item>
<item name="android:fontFamily">sans-serif-medium</item></style>
<style name="Eyebrow" parent="Body"><item name="android:textSize">11sp</item><item name="android:letterSpacing">0.12</item>
<item name="android:textColor">@color/accent</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:layout_marginTop">0dp</item></style>
<style name="Action"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item>
<item name="android:fontFamily">sans-serif-medium</item><item name="android:layout_marginTop">14dp</item>
<item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
<item name="android:background">@drawable/bg_button</item><item name="android:backgroundTint">@null</item>
<item name="android:textColor">@color/ink</item></style>
<style name="Primary" parent="Action"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">@color/accent_ink</item></style>
<style name="Input"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">54dp</item><item name="android:textSize">15sp</item><item name="android:textColor">@color/ink</item>
<item name="android:textColorHint">@color/muted</item><item name="android:background">@drawable/bg_input</item>
<item name="android:padding">14dp</item><item name="android:layout_marginTop">10dp</item><item name="android:singleLine">true</item></style>
</resources>
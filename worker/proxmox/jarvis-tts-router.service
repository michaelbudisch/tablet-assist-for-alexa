[Unit]
Description=Jarvis optional Qwen-Piper speech router
After=network-online.target piper.service
[Service]
Type=simple
User=jarvis-tts
Group=jarvis-tts
Environment=JARVIS_TTS_CONFIG=/etc/jarvis-tts-router.json
ExecStart=/usr/bin/python3 /opt/jarvis-tts-router/tts_router.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
